generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  role              Role     @default(TEACHER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  teacherClasses    Class[]  @relation("TeacherClasses")
  family            Family?
  posts             Post[]
  coordinatorSchool School?  @relation("CoordinatorSchool")
}

model School {
  id            String   @id @default(uuid())
  name          String
  coordinatorId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  classes       Class[]
  coordinator   User     @relation("CoordinatorSchool", fields: [coordinatorId], references: [id])
}

model Class {
  id        String    @id @default(uuid())
  name      String
  schoolId  String
  teacherId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id])
  teacher   User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  posts     Post[]
  students  Student[]
}

model Student {
  id             String          @id @default(uuid())
  name           String
  animalAvatar   String
  avatarColor    String          @default("#FFFFFF")
  whatsapp       String?
  email          String?
  birthday       String?
  classId        String
  familyId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendances    Attendance[]
  feedbackEvents FeedbackEvent[]
  diaryPosts     Post[]
  class          Class           @relation(fields: [classId], references: [id])
  family         Family?         @relation(fields: [familyId], references: [id])
}

model Family {
  id        String    @id @default(uuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  students  Student[]
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime         @default(now())
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model FeedbackEvent {
  id          String            @id @default(uuid())
  studentId   String
  type        FeedbackEventType
  description String
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())
  comment     String?
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Post {
  id        String   @id @default(uuid())
  content   String
  classId   String
  studentId String?
  teacherId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])
}

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  FAMILY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum FeedbackEventType {
  POSITIVE @map("positive")
  NEGATIVE @map("negative")
}
